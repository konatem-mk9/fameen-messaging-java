<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Namespace Maven Central vérifié via GitHub (io.github.konatem-mk9).
       Le package Java reste com.fameen.messaging — Central ne contraint que le groupId. -->
  <groupId>io.github.konatem-mk9</groupId>
  <artifactId>fameen-messaging</artifactId>
  <version>1.0.4</version>
  <packaging>jar</packaging>

  <name>Fameen Messaging SDK</name>
  <description>SDK Java officiel de l'API Fameen Messaging (SMS, WhatsApp, Email).</description>
  <url>https://fameenbusiness.com</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <organization>
    <name>Fameen Groupe</name>
    <url>https://fameenbusiness.com</url>
  </organization>

  <developers>
    <developer>
      <id>konatem-mk9</id>
      <name>Moussa KONATE</name>
      <email>konatem.mk9@gmail.com</email>
      <organization>Fameen Groupe</organization>
      <organizationUrl>https://fameenbusiness.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/konatem-mk9/fameen-messaging-java.git</connection>
    <developerConnection>scm:git:git@github.com:konatem-mk9/fameen-messaging-java.git</developerConnection>
    <url>https://github.com/konatem-mk9/fameen-messaging-java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Sérialisation JSON (tire jackson-core et jackson-annotations). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
      <!-- Jars sources + javadoc : exiges par Maven Central, produits par `mvn verify` (CI). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <doclint>none</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Publication Maven Central automatisée (workflow release.yml, tags vX.Y.Z).
       Activé uniquement avec -Pcentral : la compilation/tests locaux et la CI de
       branche n'ont pas besoin de GPG ni des identifiants Sonatype.
       Secrets attendus (GitHub → Settings → Secrets) : CENTRAL_USERNAME,
       CENTRAL_PASSWORD (jeton utilisateur central.sonatype.com), GPG_PRIVATE_KEY
       (clé privée ASCII-armored), GPG_PASSPHRASE. -->
  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- Passphrase lue depuis l'environnement (MAVEN_GPG_PASSPHRASE) ; mode batch pour la CI. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- serverId = <server> du settings.xml généré par setup-java (server-id: central). -->
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
